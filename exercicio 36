 #include <stdio.h>

int main() {
    int k, pares = 0, impares = 0;

    printf("Digite um numero: ");
    scanf("%d", &k);

    for (int i = 1; i <= k; i++) {
        if (i % 2 == 0) {
            pares++;
        } else {
            impares++;
        }
    }

    printf("Pares: %d\n", pares);
    printf("Impares: %d\n", impares);

    return 0;
}

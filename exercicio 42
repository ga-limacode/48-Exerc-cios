#include <stdio.h>

int main() {
    int opcao;
    float n1, n2;

    while (opcao != 0) {
        printf("\n1 - Soma");
        printf("\n2 - Multiplicacao");
        printf("\n0 - Sair");
        printf("\nEscolha: ");

        scanf("%d", &opcao);

        if (opcao == 1) {
            printf("Digite dois numeros: ");
            scanf("%f %f", &n1, &n2);

            printf("Resultado: %.2f", n1 + n2);
        }
        else if (opcao == 2) {
            printf("Digite dois numeros: ");
            scanf("%f %f", &n1, &n2);

            printf("Resultado: %.2f", n1 * n2);
        }
        else if (opcao != 0) {
            printf("Opcao invalida!");
        }
    }

    printf("\nSistema encerrado!");

    return 0;
}

#include <stdio.h>

int main() {
    int n;
    long long fatorial = 1;

    printf("Digite um numero: ");
    scanf("%d", &n);

    if (n < 0) {
        printf("Numero invalido!");
        return 0;
    }

    for (int i = n; i >= 1; i--) {
        fatorial = fatorial * i;
    }

    printf("Fatorial: %lld", fatorial);

    return 0;
}

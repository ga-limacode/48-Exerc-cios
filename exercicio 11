#include <stdio.h>

int main(void) {
    int horas;
    float valorHora, bruto, inss, ir, liquido;

    printf("Horas trabalhadas: ");
    scanf("%d", &horas);
    printf("Valor da hora (R$): ");
    scanf("%f", &valorHora);

    bruto = horas * valorHora;
    inss = bruto * 0.11f;
    ir = bruto * 0.05f;
    liquido = bruto - inss - ir;

    printf("\n--- Demonstrativo ---\n");
    printf("Salario bruto......: R$ %.2f\n", bruto);
    printf("Desconto INSS (11%%): R$ %.2f\n", inss);
    printf("Imposto de renda (5%%): R$ %.2f\n", ir);
    printf("Salario liquido....: R$ %.2f\n", liquido);

    return 0;
}
